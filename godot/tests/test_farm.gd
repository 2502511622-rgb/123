extends SceneTree
func _initialize() -> void:
	var s := FarmState.new()
	assert(s.seeds == 8)
	s.use_tool(0, 1)
	assert(s.seeds == 8)
	s.use_tool(0, 0)
	s.use_tool(0, 1)
	assert(s.seeds == 7)
	s.next_day()
	assert(s.plots[0].growth == 0)
	for i in range(3):
		s.use_tool(0, 2)
		var energy := s.energy
		s.use_tool(0, 2)
		assert(s.energy == energy)
		s.next_day()
	assert(s.plots[0].growth == 3)
	s.use_tool(0, 3)
	assert(s.harvest == 1 and not s.plots[0].crop)
	s.sell()
	assert(s.money == 155 and s.harvest == 0)
	s.buy_seeds()
	assert(s.money == 115 and s.seeds == 12)
	var restored := FarmState.new()
	assert(restored.restore(JSON.parse_string(JSON.stringify(s.snapshot()))))
	assert(restored.money == s.money and restored.day == s.day)
	assert(not restored.restore({"version": 1}))
	print("PASS: farming cycle, watering, economy, save round-trip, invalid save")
	quit()
